package com.erp.system.service;

import com.erp.system.entity.CompanyApplication;
import com.erp.system.repository.CompanyApplicationRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;

@Service
public class CompanyApplicationService {

    private final CompanyApplicationRepository repository;

    public CompanyApplicationService(CompanyApplicationRepository repository) {
        this.repository = repository;
    }

    public List<CompanyApplication> findAll() {
        return repository.findAll();
    }

    public CompanyApplication findById(Integer id) {
        return repository.findById(id)
                .orElseThrow(() -> new RuntimeException("CompanyApplication not found with id: " + id));
    }

    public List<CompanyApplication> findByCompanyId(Integer companyId) {
        return repository.findByCompanyId(companyId);
    }

    public List<CompanyApplication> findActiveByCompanyId(Integer companyId) {
        return repository.findByCompanyIdAndIsActiveTrue(companyId);
    }

    @Transactional
    public CompanyApplication create(CompanyApplication ca) {
        if (repository.existsByCompanyIdAndApplicationId(ca.getCompanyId(), ca.getApplicationId())) {
            throw new RuntimeException("Application already activated for this company");
        }
        ca.setCreatedDatetime(LocalDateTime.now());
        ca.setActivatedDate(LocalDateTime.now());
        ca.setIsActive(true);
        return repository.save(ca);
    }

    @Transactional
    public CompanyApplication update(Integer id, CompanyApplication ca) {
        CompanyApplication existing = findById(id);
        existing.setIsActive(ca.getIsActive());
        existing.setExpiredDate(ca.getExpiredDate());
        existing.setModifiedDatetime(LocalDateTime.now());
        existing.setModifiedBy(ca.getModifiedBy());
        return repository.save(existing);
    }

    @Transactional
    public void delete(Integer id) {
        CompanyApplication existing = findById(id);
        repository.delete(existing);
    }
}