package com.erp.system.controller;

import com.erp.system.entity.RoleTemp;
import com.erp.system.service.RoleTempService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/role-temp")
public class RoleTempController {

    @Autowired
    private RoleTempService roleTempService;

    @GetMapping
    public List<RoleTemp> getAllRoleTemps() {
        return roleTempService.findAll();
    }

    @GetMapping("/{id}")
    public ResponseEntity<RoleTemp> getRoleTempById(@PathVariable Integer id) {
        return roleTempService.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    @PostMapping
    public RoleTemp createRoleTemp(@RequestBody RoleTemp roleTemp) {
        return roleTempService.save(roleTemp);
    }

    @PutMapping("/{id}")
    public ResponseEntity<RoleTemp> updateRoleTemp(@PathVariable Integer id, @RequestBody RoleTemp roleTempDetails) {
        try {
            RoleTemp updatedRoleTemp = roleTempService.update(id, roleTempDetails);
            return ResponseEntity.ok(updatedRoleTemp);
        } catch (RuntimeException e) {
            return ResponseEntity.notFound().build();
        }
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> deleteRoleTemp(@PathVariable Integer id) {
        roleTempService.deleteById(id);
        return ResponseEntity.ok().build();
    }
}