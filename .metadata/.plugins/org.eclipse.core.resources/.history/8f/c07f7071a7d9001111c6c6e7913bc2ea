
package com.erp.system.controller;

import com.erp.system.dto.OtpRequest;
import com.erp.system.service.UserApplicationService;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import jakarta.servlet.http.HttpServletRequest;

import java.util.HashMap;
import java.util.Map;

@RestController
@RequestMapping("/api/auth")
@CrossOrigin(origins = "http://localhost:3000")
public class AuthController {

    @Autowired
    private UserApplicationService userApplicationService;

    @PostMapping("/verify-otp")
    public ResponseEntity<Map<String, Object>> verifyOtp(
            @RequestBody OtpRequest request,
            HttpServletRequest httpRequest) {

        // Mengambil IP Address
        String ipAddress = httpRequest.getRemoteAddr();

        // Mengambil User Agent
        String userAgent = httpRequest.getHeader("User-Agent");

        // Memanggil service untuk verifikasi OTP
        String status = userApplicationService.verifyOtp(
                request.getUsername(),
                ipAddress,
                userAgent,
                request.getDeviceId(),
                request.getOtp()
        );

        // Membentuk response JSON
        Map<String, Object> response = new HashMap<>();

        response.put("status", status);

        if ("SUCCESS".equals(status)) {

            response.put(
                "message",
                "Verifikasi OTP berhasil."
            );

            return ResponseEntity.ok(response);

        } else if (
                "MAX_ATTEMPT_REACHED".equals(status)
                || "USER_LOCKED".equals(status)) {

            response.put("error", status);

            return ResponseEntity
                    .status(403)
                    .body(response);

        } else {

            response.put("error", status);

            return ResponseEntity
                    .badRequest()
                    .body(response);
        }
    }
    

    @PostMapping("/check-device")
    public ResponseEntity> ResponseEntity<Map<String, Object>> checkDevice(@RequestBody OtpRequest request, HttpServletRequest httpRequest) {
        
        // 1. Tangkap IP dan User Agent
        String ipAddress = httpRequest.getRemoteAddr();
        String userAgent = httpRequest.getHeader("User-Agent");

        // 2. Panggil fungsi verifikasi perangkat & pembuatan OTP
        String status = userApplicationService.verifyDevice(
                request.getUsername(), 
                ipAddress, 
                userAgent, 
                request.getDeviceId()
        );

        // 3. Bentuk balasan ke Next.js
        Map<String, Object> response = new HashMap<>();
        response.put("status", status);

        if ("SUCCESS".equals(status)) {
            // Perangkat sudah dikenali, tidak butuh OTP
            response.put("requireOtp", false);
            return ResponseEntity.ok(response);
            
        } else if ("REQUIRE_OTP".equals(status)) {
            // Perangkat baru, OTP berhasil dibuat dan dikirim ke DB + Email
            response.put("requireOtp", true);
            response.put("message", "OTP telah dikirim");
            return ResponseEntity.ok(response);
            
        } else {
            // Jika statusnya USER_LOCKED (melebihi batas 5x kirim)
            response.put("error", status);
            return ResponseEntity.status(403).body(response);
        }
    }
}
