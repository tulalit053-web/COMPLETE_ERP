package com.erp.system.service;

import com.erp.system.entity.Menu;
import com.erp.system.repository.MenuRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;

@Service
public class MenuService {

    private final MenuRepository repository;
    private final UserPermissionService userPermissionService;

    public MenuService(MenuRepository repository,
                       UserPermissionService userPermissionService) {
        this.repository = repository;
        this.userPermissionService = userPermissionService;
    }

    public List<Menu> findAll(String username) {
        return repository.findAll();
    }

    public Menu findById(Integer id, String username) {
        return repository.findById(id)
                .orElseThrow(() -> new RuntimeException("Menu not found with id: " + id));
    }

    public List<Menu> findByModuleId(Integer moduleId, String username) {
        return repository.findByModuleId(moduleId);
    }

    @Transactional
    public Menu create(Menu menu, String username) {
        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            throw new RuntimeException("Only Global Super Admin can create menu");
        }
        menu.setCreatedDatetime(LocalDateTime.now());
        return repository.save(menu);
    }

    @Transactional
    public Menu update(Integer id, Menu menu, String username) {
        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            throw new RuntimeException("Only Global Super Admin can update menu");
        }

        Menu existing = findById(id, username);
        existing.setParentMenuId(menu.getParentMenuId());
        existing.setMenuCode(menu.getMenuCode());
        existing.setMenuName(menu.getMenuName());
        existing.setMenuLink(menu.getMenuLink());
        existing.setMenuIndex(menu.getMenuIndex());
        existing.setIsActive(menu.getIsActive());
        existing.setIconName(menu.getIconName());
        existing.setModuleId(menu.getModuleId());
        existing.setShowInSidemenu(menu.getShowInSidemenu());
        existing.setModifiedDatetime(LocalDateTime.now());
        existing.setModifiedBy(menu.getModifiedBy());
        return repository.save(existing);
    }

    @Transactional
    public void delete(Integer id, String username) {
        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            throw new RuntimeException("Only Global Super Admin can delete menu");
        }
        Menu existing = findById(id, username);
        repository.delete(existing);
    }
}