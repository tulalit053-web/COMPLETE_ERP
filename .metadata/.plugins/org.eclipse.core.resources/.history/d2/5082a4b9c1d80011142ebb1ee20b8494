    public UserApplication update(Integer id, UserApplication userDetails, String username) {
        UserApplication existing = findById(id, username)
                .orElseThrow(() -> new RuntimeException("User not found or access denied"));

        // Update di Keycloak
        try {
            UserRepresentation kcUser = keycloak.realm(targetRealm)
                    .users()
                    .search(existing.getUsername())
                    .stream()
                    .findFirst()
                    .orElse(null);

            if (kcUser != null) {
                kcUser.setEmail(userDetails.getEmail());
                kcUser.setFirstName(userDetails.getName());
                kcUser.setEnabled(userDetails.getIsActive() != null && userDetails.getIsActive() == 1);
                keycloak.realm(targetRealm).users().get(kcUser.getId()).update(kcUser);
            }
        } catch (Exception e) {
            throw new RuntimeException("Gagal update user di Keycloak: " + e.getMessage());
        }

        // Update di database
        existing.setRoleId(userDetails.getRoleId());
        existing.setEmployeeCode(userDetails.getEmployeeCode());
        existing.setName(userDetails.getName());
        existing.setEmail(userDetails.getEmail());
        existing.setMobilePhone(userDetails.getMobilePhone());
        existing.setIsActive(userDetails.getIsActive());
        existing.setCompany(userDetails.getCompany());
        existing.setCurrency(userDetails.getCurrency());
        existing.setRegional(userDetails.getRegional());
        existing.setBranch(userDetails.getBranch());
        existing.setSubBranch(userDetails.getSubBranch());
        existing.setModifiedBy(userDetails.getModifiedBy());

        return userRepository.save(existing);
    }

