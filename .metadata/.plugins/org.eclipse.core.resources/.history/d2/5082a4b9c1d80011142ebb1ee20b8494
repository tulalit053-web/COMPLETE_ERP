    public String verifyOtp(String username, String ipAddress, String userAgent, String deviceId, String inputOtp) {
        UserOtp otp = userOtpRepository
                .findTopByUsernameAndDeviceIdAndStatusOrderByCreatedDatetimeDesc(username, deviceId, "PENDING")
                .orElse(null);

        if (otp == null) return "INVALID";

        if (otp.getExpiredDatetime().isBefore(LocalDateTime.now())) {
            otp.setStatus("EXPIRED");
            userOtpRepository.save(otp);
            return "EXPIRED";
        }

        // === TAMBAHAN: CEK ATTEMPT COUNT ===
        if (otp.getAttemptCount() >= 3) {
            otp.setStatus("EXPIRED");
            userOtpRepository.save(otp);
            return "MAX_ATTEMPT_REACHED"; // Memberi tahu Next.js untuk kembali ke halaman awal
        }

        if (passwordEncoder.matches(inputOtp, otp.getOtpCode())) {
            otp.setStatus("VERIFIED");
            userOtpRepository.save(otp);
            recordLogin(username, ipAddress, userAgent, deviceId, "SUCCESS", "OTP Verified");
            return "SUCCESS";
        } else {
            // Jika salah, naikkan angka attempt
            otp.setAttemptCount(otp.getAttemptCount() + 1);
            
            if (otp.getAttemptCount() >= 3) {
                otp.setStatus("EXPIRED");
                userOtpRepository.save(otp);
                return "MAX_ATTEMPT_REACHED";
            }
            
            userOtpRepository.save(otp);
            return "INVALID_CODE"; // Masih boleh mencoba
        }
    }

