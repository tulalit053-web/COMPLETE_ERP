    public UserApplication createUser(UserApplication userApp, String currentUsername) {
        // Cek hak akses
        if (!userPermissionService.isGlobalSuperAdmin(currentUsername)) {
            Integer companyId = userPermissionService.getCurrentUserCompanyId(currentUsername);
            if (userApp.getCompanyId() == null || !companyId.equals(userApp.getCompanyId())) {
                throw new RuntimeException("You can only create user in your own company");
            }
        }

        if (userRepository.existsByUsername(userApp.getUsername())) {
            throw new RuntimeException("Username sudah terdaftar di sistem ERP");
        }

        // Siapkan user Keycloak
        UserRepresentation kcUser = new UserRepresentation();
        kcUser.setUsername(userApp.getUsername());
        kcUser.setEmail(userApp.getEmail());
        kcUser.setFirstName(userApp.getName());
        kcUser.setEnabled(true);
        kcUser.setEmailVerified(false); // biarkan false, supaya Keycloak minta verifikasi

        // Password
        CredentialRepresentation credential = new CredentialRepresentation();
        credential.setType(CredentialRepresentation.PASSWORD);
        credential.setValue(userApp.getPassword());
        credential.setTemporary(true); // true = user wajib ganti password saat login pertama
        kcUser.setCredentials(Collections.singletonList(credential));

        // Required Actions
        kcUser.setRequiredActions(Arrays.asList("VERIFY_EMAIL", "UPDATE_PASSWORD"));

        // Buat user di Keycloak
        Response response = keycloak.realm(targetRealm).users().create(kcUser);

        if (response.getStatus() == 201) {
            userApp.setPassword(null); // jangan simpan password di database
            return userRepository.save(userApp);
        } else {
            String error = response.readEntity(String.class);
            throw new RuntimeException("Gagal membuat user di Keycloak. Status: " 
                + response.getStatus() + " - " + error);
        }
    }

