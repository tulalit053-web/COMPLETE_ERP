        } else {
            Integer companyId = userPermissionService.getCurrentUserCompanyId(username);
            return userRepository.findByCompanyId(companyId);
        }
    }

    public Optional<UserApplication> findById(Integer id, String username) {
        Optional<UserApplication> userOpt = userRepository.findById(id);
        if (userOpt.isEmpty()) return Optional.empty();

        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            Integer companyId = userPermissionService.getCurrentUserCompanyId(username);
            if (!companyId.equals(userOpt.get().getCompanyId())) {
                return Optional.empty();
            }
        }
        return userOpt;
    }

