    public void deleteById(Integer id, String username) {
        UserApplication existing = findById(id, username)
                .orElseThrow(() -> new RuntimeException("User not found or access denied"));

        // Disable di Keycloak (lebih aman daripada hard delete)
        try {
            UserRepresentation kcUser = keycloak.realm(targetRealm)
                    .users()
                    .search(existing.getUsername())
                    .stream()
                    .findFirst()
                    .orElse(null);

            if (kcUser != null) {
                kcUser.setEnabled(false);
                keycloak.realm(targetRealm).users().get(kcUser.getId()).update(kcUser);
            }
        } catch (Exception e) {
            throw new RuntimeException("Gagal disable user di Keycloak: " + e.getMessage());
        }

        // Hapus atau nonaktifkan di database
        existing.setIsActive(0);
        userRepository.save(existing);
        // atau userRepository.delete(existing); kalau ingin hard delete
    }

    public List<UserApplication> findByCompanyId(Integer companyId, String username) {
        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            Integer userCompanyId = userPermissionService.getCurrentUserCompanyId(username);
            if (!userCompanyId.equals(companyId)) {
                throw new RuntimeException("Access denied to this company");
            }
        }
        return userRepository.findByCompanyId(companyId);
    }

    public List<UserApplication> findActiveByCompanyId(Integer companyId, String username) {
        if (!userPermissionService.isGlobalSuperAdmin(username)) {
            Integer userCompanyId = userPermissionService.getCurrentUserCompanyId(username);
            if (!userCompanyId.equals(companyId)) {
                throw new RuntimeException("Access denied to this company");
            }
        }
        return userRepository.findByCompanyIdAndIsActive(companyId, 1);
    }

    public UserApplication findByUsername(String username) {
        return userRepository.findByUsername(username)
                .orElseThrow(() -> new RuntimeException("User not found with username: " + username));
    }
    
    public void changePassword(String username, String newPassword, String currentUsername) {
        // Cek hak akses (bisa hanya diri sendiri atau admin)
        UserApplication user = findByUsername(username);

        try {
            UserRepresentation kcUser = keycloak.realm(targetRealm)
                    .users()
                    .search(username)
                    .stream()
                    .findFirst()
                    .orElseThrow(() -> new RuntimeException("User tidak ditemukan di Keycloak"));

            CredentialRepresentation credential = new CredentialRepresentation();
            credential.setType(CredentialRepresentation.PASSWORD);
            credential.setValue(newPassword);
            credential.setTemporary(false);

            keycloak.realm(targetRealm)
                    .users()
                    .get(kcUser.getId())
                    .resetPassword(credential);

        } catch (Exception e) {
            throw new RuntimeException("Gagal ganti password di Keycloak: " + e.getMessage());
        }
    }   

    public void recordLogin(String username, String ipAddress, String userAgent, 
            String deviceId, String status, String remarks) {
        try {
            UserApplication user = userRepository.findByUsername(username).orElse(null);
            
            LoginLog log = new LoginLog();
            log.setUsername(username);
            log.setLoginDatetime(LocalDateTime.now());
            log.setIpAddress(ipAddress);
            log.setUserAgent(userAgent);
            log.setDeviceId(deviceId);
            log.setLoginStatus(status);
            log.setRemarks(remarks);
            
            if (user != null) {
                log.setUserId(user.getId());
                log.setCompanyId(user.getCompanyId());
            }
            
            loginLogRepository.save(log);
        } catch (Exception e) {
            System.err.println("Gagal mencatat login log: " + e.getMessage());
        }
    }

