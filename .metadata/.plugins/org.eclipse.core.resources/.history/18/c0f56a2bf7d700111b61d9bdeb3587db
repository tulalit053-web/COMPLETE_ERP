package com.erp.system.util;

import jakarta.persistence.AttributeConverter;
import jakarta.persistence.Converter;
import javax.crypto.Cipher;
import javax.crypto.spec.SecretKeySpec;
import java.security.Key;
import java.util.Base64;

@Converter
public class AesCryptoConverter implements AttributeConverter<String, String> {

    // Kunci Rahasia AES-256 (Wajib 32 karakter). 
    // Catatan: Untuk tahap production nanti, pindahkan kunci ini ke Environment Variables.
    private static final String SECRET_KEY = "OjkErpSystemSecretKeyLapisBaja26"; 
    private static final String ALGORITHM = "AES";

    @Override
    public String convertToDatabaseColumn(String attribute) {
        if (attribute == null) return null;
        try {
            Key key = new SecretKeySpec(SECRET_KEY.getBytes(), ALGORITHM);
            Cipher cipher = Cipher.getInstance(ALGORITHM);
            cipher.init(Cipher.ENCRYPT_MODE, key);
            return Base64.getEncoder().encodeToString(cipher.doFinal(attribute.getBytes()));
        } catch (Exception e) {
            throw new RuntimeException("Gagal mengenkripsi data", e);
        }
    }

    @Override
    public String convertToEntityAttribute(String dbData) {
        if (dbData == null) return null;
        try {
            Key key = new SecretKeySpec(SECRET_KEY.getBytes(), ALGORITHM);
            Cipher cipher = Cipher.getInstance(ALGORITHM);
            cipher.init(Cipher.DECRYPT_MODE, key);
            return new String(cipher.doFinal(Base64.getDecoder().decode(dbData)));
        } catch (Exception e) {
            // Mekanisme pelindung: Jika membaca data lama yang belum terenkripsi di tabel,
            // kembalikan data apa adanya agar sistem tidak crash.
            return dbData; 
        }
    }
}