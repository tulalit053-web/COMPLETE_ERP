package com.erp.system.entity;

import jakarta.persistence.*;
import java.time.LocalDateTime;

import com.erp.system.util.AesCryptoConverter;

import jakarta.persistence.Convert;

@Entity
@Table(name = "adm_mst_user_application", schema = "schema_admin")
public class UserApplication {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "dmuapp_id")
    private Integer id;

    @Column(name = "dmuapp_role_id")
    private Integer roleId;

    @Column(name = "dmuapp_employee_code", length = 50)
    private String employeeCode;

    @Column(name = "dmuapp_name", nullable = false, length = 250)
    private String name;

    @Column(name = "dmuapp_username", nullable = false, unique = true, length = 250)
    private String username;

    @Convert(converter = AesCryptoConverter.class)
    @Column(name = "dmuapp_email")
    private String dmuappEmail;

    @Convert(converter = AesCryptoConverter.class)
    @Column(name = "dmuapp_mobilephone")
    private String dmuappMobilephone;

    @Convert(converter = AesCryptoConverter.class)
    @Column(name = "dmuapp_nik") // Contoh jika ada Nomor Induk Kependudukan
    private String dmuappNik;

    @Column(name = "dmuapp_is_active")
    private Integer isActive;

    @Column(name = "dmuapp_is_login")
    private Integer isLogin;

    @Column(name = "dmuapp_login_date")
    private LocalDateTime loginDate;

    @Column(name = "dmuapp_logout_date")
    private LocalDateTime logoutDate;

    @Column(name = "dmuapp_company_id")                 // ← kolom penting baru
    private Integer companyId;

    @Column(name = "dmuapp_company", length = 50)
    private String company;

    @Column(name = "dmuapp_currency", length = 50)
    private String currency;

    @Column(name = "dmuapp_regional", length = 50)
    private String regional;

    @Column(name = "dmuapp_branch", length = 50)
    private String branch;

    @Column(name = "dmuapp_subbranch", length = 50)
    private String subBranch;

    @Column(name = "dmuapp_password", length = 300)
    private String password;

    @Column(name = "dmuapp_last_change_pwd")
    private LocalDateTime lastChangePwd;

    @Column(name = "dmuapp_must_change_pwd")
    private Boolean mustChangePwd;

    @Column(name = "dmuapp_created_datetime")
    private LocalDateTime createdDatetime;

    @Column(name = "dmuapp_created_by", length = 100)
    private String createdBy;

    @Column(name = "dmuapp_modified_datetime")
    private LocalDateTime modifiedDatetime;

    @Column(name = "dmuapp_modified_by", length = 100)
    private String modifiedBy;

}