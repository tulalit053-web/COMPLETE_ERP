server:
  port: 8888

spring:
  application:
    name: erp-config-server

  profiles:
    active: native

  cloud:
    config:
      server:
        native:
          search-locations: classpath:/config

eureka:
  instance:
    hostname: localhost          # atau biarkan erp-config, tapi lebih aman localhost dulu
    prefer-ip-address: true      # disarankan ditambahkan
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
    register-with-eureka: true
    fetch-registry: true

