    private String normalizePath(String path) {
        if (path == null) return "";

        // Hilangkan prefix Gateway yang umum
        if (path.startsWith("/api/admins")) {
            path = path.substring("/api/admins".length());
        } else if (path.startsWith("/api/")) {
            // fallback kalau prefix lain
            int secondSlash = path.indexOf("/", 5);
            if (secondSlash > 0) {
                path = path.substring(secondSlash);
            }
        }

        // Hilangkan trailing slash
        if (path.length() > 1 && path.endsWith("/")) {
            path = path.substring(0, path.length() - 1);
        }

        return path.isEmpty() ? "/" : path;
    }

    private String mapMethodToAction(String method) {
        return switch (method.toUpperCase()) {
            case "POST"   -> "ADD";
            case "PUT", "PATCH" -> "EDIT";
            case "DELETE" -> "DELETE";
            default       -> "VIEW";
        };
    }

    private void sendError(HttpServletResponse response, int status, String message) throws IOException {
        response.setStatus(status);
        response.setContentType(MediaType.APPLICATION_JSON_VALUE);
        response.getWriter().write("""
            {
              "status": %d,
              "error": "%s",
              "message": "%s"
            }
            """.formatted(status, status == 403 ? "Forbidden" : "Unauthorized", message));
    }
}